###############################################################################
# KEneYa WorkFlow — configuration d'exemple
#
# Copier ce fichier en `.env` puis adapter. Aucun identifiant ne doit etre
# ecrit en dur dans le code : tout passe par ce fichier.
###############################################################################

# --- Application -------------------------------------------------------------
APP_NAME="KEneYa WorkFlow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8083

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Bamako

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Identite de l'etablissement ---------------------------------------------
# KENEYA_NAME est affiche dans l'interface et dans les SMS.
# KENEYA_CODE_PREFIX prefixe les identifiants de dossier (ex. HFD-00001) : le
# changer lors d'un deploiement dans un autre etablissement malien.
KENEYA_NAME="KƐnƐya WorkFlow"
KENEYA_HOSPITAL="Hopital Fousseyni Daou de Kayes"
KENEYA_CODE_PREFIX=HFD

# Intervalle de rafraichissement Livewire (wire:poll). Pas de WebSocket.
KENEYA_POLL_INTERVAL=5s
KENEYA_BOARD_POLL_INTERVAL=5s

# --- Journalisation ----------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de donnees ---------------------------------------------------------
# Sous Docker Compose, DB_HOST doit valoir `db` (le nom du service).
# Hors Docker, mettre 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=keneya_wf_mod
DB_USERNAME=keneya
DB_PASSWORD=changez-ce-mot-de-passe

# Mot de passe root MySQL, utilise uniquement par le conteneur `db`.
DB_ROOT_PASSWORD=changez-ce-mot-de-passe-root

# --- Sessions, cache, files d'attente ----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

# Les SMS partent en arriere-plan depuis la v3.2.8 : `database` suffit pour ce
# volume, la base deja en place fait office de file (tables `jobs` et
# `failed_jobs`). Aucun conteneur supplementaire de type Redis n'est requis,
# mais le service `queue-worker` de docker-compose.yml doit tourner : sans lui,
# les messages s'empilent dans `jobs` et aucun SMS ne part.
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Passerelle SMS (SMSGate, application Android auto-hebergee) --------------
# SMSGATE_URL pointe vers l'API du telephone qui heberge SMSGate :
#   - meme reseau local  : http://<ip-locale>:8080 (ex. 192.168.1.50)
#   - tunnel VPN         : http://<ip-vpn-du-telephone>:8080
#   - relais cloud       : l'URL fournie par le service de relais
# Le code est identique dans les trois cas : seule cette URL change.
# Le serveur local de SMSGate doit etre demarre, et l'application exclue de
# l'optimisation de batterie d'Android, sans quoi elle cesse de repondre des
# qu'elle passe en arriere-plan (voir docs/exploitation-demo.md).
# Mettre SMSGATE_ENABLED=false pour desactiver les SMS (formation, recette).
SMSGATE_ENABLED=true
SMSGATE_URL=http://192.168.1.50:8080
SMSGATE_LOGIN=sms
SMSGATE_PASSWORD=changez-ce-mot-de-passe-sms
SMSGATE_TIMEOUT=10
SMSGATE_COUNTRY_CODE=223

# --- Comptes de demonstration ------------------------------------------------
# Mot de passe attribue aux comptes crees par `php artisan db:seed`.
# A changer avant toute mise en service reelle.
SEED_DEFAULT_PASSWORD=changez-ce-mot-de-passe-seed

# --- Ports publies par Docker Compose ----------------------------------------
APP_HTTP_PORT=8083
DB_PUBLISHED_PORT=3309

# --- Courriel (non utilise dans cette phase, conserve pour Laravel) ----------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="keneya@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- Module Dossier Medical Electronique (keneya/dme) ------------------------
# Le module tourne ici en invite : l'authentification, la session et la
# decision d'acces viennent de WorkFlow. Son mode autonome de developpement
# fabriquerait une session locale et considererait l'acces comme accorde : il
# doit rester desactive dans cette configuration assemblee.
DME_STANDALONE_DEV=false
DME_STANDALONE_AUTO_LOGIN=false

# Prefixe d'URL du module. Les routes sont nommees `dme.*`.
DME_ROUTE_PREFIX=dme

# Capacite de haut niveau qui ouvre le dossier medical, portee par le systeme
# de types de personnel de WorkFlow (v3.2.2).
DME_ACCESS_ATTRIBUTE=can_access_dme

# Un seul disque pour les fichiers, WorkFlow et DME. Les deux gardent leurs
# tables — l'operationnel et le dossier medical ne sont pas le meme objet ni
# les memes droits — mais les fichiers n'ont aucune raison d'etre stockes
# deux fois, ni sauvegardes deux fois.
DME_DOCUMENTS_DISK=attachments
